{
  "name": "@ProgmRuanSilva/omp-web",
  "version": "1.202606.7",
  "description": "Web UI for persistent Pi Coding Agent sessions in real workspaces.",
  "license": "MIT",
  "author": "ProgmRuanSilva",
  "type": "module",
  "bin": {
    "omp-web": "dist/cli.js",
    "omp-web-server": "dist/server/index.js",
    "omp-web-sessiond": "dist/server/sessiond.js"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE",
    "extensions",
    "docs/plugins.md",
    "docs/config.md",
    "docs/assets",
    "plugin-api.d.ts",
    "plugin-api/unstable.d.ts"
  ],
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; bun run dev:sessiond & bun run dev:web & bun run dev:client & wait'",
    "dev:sessiond": "bun --watch src/server/sessiond.ts",
    "dev:web": "bash -c 'set -e; bun run build:plugins; trap \"kill 0\" EXIT; bun run dev:plugins & bun --watch src/server/index.ts & wait'",
    "dev:server": "bun run dev:web",
    "dev:client": "vite --host 0.0.0.0",
    "dev:plugins": "bun scripts/build-plugins.mjs --watch",
    "build": "tsc -p tsconfig.build.json && bun run build:plugin-api && bun run build:plugins && vite build",
    "build:plugin-api": "tsc -p tsconfig.plugin-api.json",
    "build:plugins": "tsc -p tsconfig.plugins.json && bun scripts/build-plugins.mjs",
    "capture:screenshots": "bun scripts/capture-screenshots.mjs",
    "start": "bun src/server/index.ts",
    "start:sessiond": "bun src/server/sessiond.ts",
    "lint": "eslint \"src/**/*.ts\" \"extensions/**/*.ts\" \"omp-web-plugins/**/*.ts\" vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "verify": "bun run typecheck && bun run lint && bun run knip && bun test",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "pack:dry": "bun pm pack --dry-run",
    "prepublishOnly": "bun run verify",
    "publish:npm": "npm publish --access public",
    "prepare": "bun scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "changelog:status": "changeset status"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bun-pty": "^0.4.10",
    "diff": "^8.0.4",
    "fastify": "^5.6.1",
    "lit": "^3.3.1",
    "marked": "^18.0.3",
    "node-pty": "^1.1.0",
    "typebox": "1.1.38",
    "croner": "^10.0.1",
    "nanoid": "^5.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@oh-my-pi/pi-agent-core": "^16.3.6",
    "@oh-my-pi/pi-ai": "^16.3.6",
    "@oh-my-pi/pi-coding-agent": "^16.3.6",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "knip": "^6.16.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgmRuanSilva/omp-web.git"
  },
  "bugs": {
    "url": "https://github.com/ProgmRuanSilva/omp-web/issues"
  },
  "homepage": "https://omp-web.dev/",
  "packageManager": "bun@1.3.14",
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": ">=16.3.6 <17",
    "@oh-my-pi/pi-ai": ">=16.3.6 <17",
    "@oh-my-pi/pi-coding-agent": ">=16.3.6 <17"
  },
  "keywords": [
    "pi-package",
    "pi",
    "omp-web",
    "omp-web-ui",
    "omp-webui",
    "omp-coding-agent",
    "omp-coding-agent-web-ui",
    "coding-agent",
    "ai-coding-agent",
    "agentic-development",
    "developer-tools",
    "web-ui",
    "webui",
    "browser-ui",
    "remote-development",
    "persistent-sessions"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/ProgmRuanSilva/omp-web/main/docs/assets/omp-web-banner.png"
  }
}
